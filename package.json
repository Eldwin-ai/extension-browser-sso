{
  "name": "@eldwin-ai/extension-browser-sso",
  "version": "0.1.0",
  "description": "Generic browser cookie SSO session helpers — Chrome import, auto-auth, GET reads.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./auto-auth": "./src/autoAuth.mjs",
    "./chrome-cookies": "./src/chromeCookies.mjs",
    "./cookie-jar": "./src/cookieJar.mjs",
    "./html-session-extract": "./src/htmlSessionExtract.mjs",
    "./browser-login": "./src/browserLogin.mjs",
    "./browser-http-read": "./src/browserHttpRead.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "src"
  ],
  "scripts": {
    "test": "npm exec -- eldwin-package-test",
    "test:unit": "npm exec -- eldwin-package-test -- --unit",
    "test:mock": "npm exec -- eldwin-package-test -- --mock",
    "test:integration": "npm exec -- eldwin-package-test -- --integration"
  },
  "agentRuntimeDistribution": {
    "visibility": "public",
    "group": "browser-sso",
    "serviceGrouping": "single-service",
    "publicService": false,
    "rationale": "Library extension — browser cookie session primitives for read-only HTTP GET."
  },
  "dependencies": {
    "@eldwin-ai/eldwin": "^0.1.3",
    "@eldwin-ai/extension-read-only-toolkit": "^0.1.0"
  },
  "devDependencies": {
    "vitest": "^3.1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eldwin-ai/extension-browser-sso.git"
  }
}
